{
  "name": "@geo-agent-platform/operations-supervisor",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "bin": {
    "geo-agent-platform-supervisor": "./dist/cli.js",
    "geo-agent-platform-dev": "./dist/devCli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./packaged-local-runtime": "./dist/packagedLocalRuntime.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "build:dev": "tsc -p tsconfig.json",
    "dev": "tsx src/devCli.ts",
    "test": "vitest run src",
    "test:watch": "vitest src"
  },
  "dependencies": {
    "@geo-agent-platform/shared-types": "file:../shared-types",
    "concurrently": "10.0.4",
    "dotenv": "17.4.2",
    "pino": "10.3.1",
    "proper-lockfile": "4.1.2",
    "rotating-file-stream": "3.2.10",
    "strip-ansi": "7.2.0",
    "systeminformation": "5.33.1",
    "tree-kill": "1.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
