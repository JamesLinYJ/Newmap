{
  "name": "geo-agent-server",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "predev": "npm run build:dev --workspace @geo-agent-platform/db",
    "dev": "tsx watch src/main.ts",
    "dev:supervised": "tsx watch --clear-screen=false src/main.ts",
    "build": "npm run build --workspace @geo-agent-platform/db && node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "pretest": "npm run build:dev --workspace @geo-agent-platform/db",
    "test": "node scripts/run-vitest-with-env.mjs run src",
    "pretest:watch": "npm run build:dev --workspace @geo-agent-platform/db",
    "test:watch": "node scripts/run-vitest-with-env.mjs src"
  },
  "dependencies": {
    "@better-auth/electron": "1.6.29",
    "@geo-agent-platform/db": "file:../../packages/db",
    "@geo-agent-platform/operations-supervisor": "file:../../packages/operations-supervisor",
    "@geo-agent-platform/shared-types": "file:../../packages/shared-types",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@openai/agents": "0.15.0",
    "@turf/turf": "^7.4.0",
    "ajv": "^8.20.0",
    "better-auth": "1.6.29",
    "busboy": "^1.6.0",
    "casbin": "^5.51.1",
    "cron-parser": "^5.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "geotiff": "3.0.5",
    "hono": "^4.13.2",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "mustache": "^4.2.0",
    "openai": "7.4.0",
    "p-queue": "^9.3.3",
    "pg": "^8.23.0",
    "pg-boss": "^12.27.0",
    "pino": "^10.3.1",
    "proj4": "2.21.0",
    "prom-client": "^15.1.3",
    "quick-lru": "7.3.0",
    "rate-limiter-flexible": "^11.2.0",
    "sharp": "0.35.3",
    "undici": "^8.10.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
