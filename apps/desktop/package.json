{
  "name": "@geo-agent-platform/desktop",
  "private": true,
  "version": "0.1.4",
  "description": "可配置产品代号的地理智能工作台",
  "author": {
    "name": "Geo Agent Platform Contributors"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run package:windows",
    "package:windows": "npm --prefix ../.. run build:desktop && electron-forge package --platform win32 --arch x64",
    "package:macos:x64": "npm --prefix ../.. run build:desktop && electron-forge package --platform darwin --arch x64",
    "package:macos:arm64": "npm --prefix ../.. run build:desktop && electron-forge package --platform darwin --arch arm64",
    "package:linux": "npm --prefix ../.. run build:desktop && electron-forge package --platform linux --arch x64",
    "make": "npm run make:windows",
    "make:windows": "npm --prefix ../.. run build:desktop && pwsh -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-squirrel-vendor.ps1 && electron-forge make --platform win32 --arch x64",
    "make:macos:x64": "npm --prefix ../.. run build:desktop && electron-forge make --platform darwin --arch x64",
    "make:macos:arm64": "npm --prefix ../.. run build:desktop && electron-forge make --platform darwin --arch arm64",
    "make:linux": "npm --prefix ../.. run release:runtime:linux && npm run make:linux:from-runtime",
    "make:linux:rpm": "npm run make:linux",
    "make:release": "pwsh -NoProfile -ExecutionPolicy Bypass -File ../../scripts/make-desktop-release.ps1",
    "lint": "oxlint src --type-aware",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "make:linux:from-runtime": "npm --prefix ../.. run verify:runtime && npm --prefix ../.. run build:desktop && electron-forge make --platform linux --arch x64"
  },
  "devDependencies": {
    "@better-auth/electron": "1.6.27",
    "@dagrejs/dagre": "^3.1.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-base": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/windows-sign": "2.0.6",
    "@geo-agent-platform/conversation-presentation": "file:../../packages/conversation-presentation",
    "@geo-agent-platform/operations-supervisor": "file:../../packages/operations-supervisor",
    "@geo-agent-platform/shared-types": "file:../../packages/shared-types",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/archiver": "8.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@xyflow/react": "^12.11.3",
    "archiver": "8.0.0",
    "better-auth": "1.6.27",
    "conf": "15.1.0",
    "date-fns": "^4.4.0",
    "electron": "43.4.0",
    "electron-log": "5.4.4",
    "electron-vite": "^6.0.0-beta.1",
    "electron-window-state": "5.0.3",
    "form-data": "4.0.6",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "^6.3.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.51.0",
    "oxc-parser": "^0.144.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.12.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "rotating-file-stream": "3.2.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  }
}
